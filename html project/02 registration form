</head>
<body>
 <center><h1>Tech Club</h1></center> 
 <center><h2>Member Registration Form</h2></center>  
 <center><h3>Join Our Community-Build your future  </h3></center>  
 <hr>
 <h2>Personal Information:-</h2>
 <hr>
 <h3>Full Name:<input type="text" placeholder="Enter Your name"></h3>
 <h3>Mob no.:<input type="text" placeholder="Enter Your Mob No."></h3>
<h3>Email address:<input type="text" placeholder="Enter Your Email address"></h3>

<h3>DOB: <input type="date"></h3>

<h3>Gender:</h3>
<input type="radio" name="gender" >Male
<input type="radio" name="gender">Female
<input type="radio" name="gender">Other
<br>
<hr>
<h2>Academic Details:</h2>
<hr>
<h3>College Name:<input type="text" placeholder="Enter Your College Name"></h3>
<h3>Course/Branch: 
<select name="course" id="1">
<option value="Cse-AI ML">Cse-AI ML</option>
<option value="Cse-Cyber Security">Cse-Cyber Security</option>
<option value="Cse-data science">Cse-data science</option>
<option value="Cse-Core">Cse-Core</option>
<option value="Cse-Block Chain">Cse-Block Chain</option>
<option value="BCA">BCA</option>
</select>
</h3>
<h3>Year:
<select name="year" id="2">
    <option value="2026">2026</option>
    <option value="2025">2025</option>
    <option value="2024">2024</option>
    <option value="2023">2023</option>
    <option value="2022">2022</option>
    <option value="2021">2021</option>
    <option value="2020">2020</option>
    <option value="2019">2019</option>
    </select>
    </h3>
    <h3>Student Id:<input type="text" placeholder="Enter your id"></h3>
    <hr>
<h2>Technical Skills:</h2>
<hr>
<label for id="101">
<input type="checkbox" value="C++" name="skills" id="101">C++
</label>
<label for id="102">
<input type="checkbox" value="Python" name="skills" id="102">Python
</label>
<br>
<label for id="103">
<input type="checkbox" value="HTML" name="skills" id="103">HTML
</label>
<label for id="104">
<input type="checkbox" value="CSS" name="skills" id="104">CSS
<br>
</label>
<label for id="105">
<input type="checkbox" value="JavaScript" name="skills" id="105">JavaScript
</label>
<label for id="106">
<input type="checkbox" value="React" name="skills" id="106">React
</label>
<hr>
<h2> Preferred Domain:</h2>
<hr>
<input type="radio" name="domain" >Web Development
<input type="radio" name="domain" >AI-ML
<input type="radio" name="domain" >Cyber Security
<input type="radio" name="domain" >Data Science
<input type="radio" name="domain" >Other
<br>
<h2>About Yourself</h2>
<textarea name="About myself" id="111" placeholder="Write something about yourself" rows="5"></textarea>
<center>    
<input type="submit" value="submit">
</center>
